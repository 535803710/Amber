FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token

# Optional. Fill this only when Feishu bot signature verification is enabled.
FEISHU_WEBHOOK_SECRET=

# 飞书多维表格“接收到 Webhook 时”自动化提供的地址和 Bearer token。
FEISHU_CHANGE_WEBHOOK_URL=
FEISHU_CHANGE_WEBHOOK_TOKEN=

# Git commit records use an independent Base workflow webhook. Token is optional.
FEISHU_COMMIT_WEBHOOK_URL=
FEISHU_COMMIT_WEBHOOK_TOKEN=

# Optional. Default editor when auto-detection fails: Codex or Cursor
# MI_NOTIC_EDITOR=Cursor

# Optional. Same status and message will not notify repeatedly within this window.
VIBECODING_NOTIFY_DEDUPE_SECONDS=300
