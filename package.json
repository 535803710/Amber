{
  "name": "amber",
  "version": "1.4.0-mvp.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "notify": "node scripts/notify.mjs",
    "status": "node scripts/status.mjs",
    "notify:test": "node scripts/notify.mjs test \"手环通知链路测试\"",
    "status:done": "node scripts/status.mjs done \"任务完成\"",
    "status:wait": "node scripts/status.mjs wait \"需要你接管确认\"",
    "run:notify": "node scripts/run-notify.mjs",
    "check:status": "node scripts/check-status.mjs",
    "watch:notifications": "node scripts/watch-notifications.mjs",
    "watch:ui-prompts": "node scripts/watch-ui-prompts.mjs",
    "watch:all": "node scripts/start-watch-stack.mjs --profile full",
    "watch:core": "node scripts/start-watch-stack.mjs --profile core",
    "health:status": "node scripts/health-monitor-worker.mjs --status",
    "health:once": "node scripts/health-monitor-worker.mjs --once",
    "records:worker": "node scripts/change-record-worker.mjs",
    "records:status": "node scripts/change-record-worker.mjs --status",
    "records:dry-run": "node scripts/change-record-worker.mjs --once --dry-run",
    "records:replay": "node scripts/change-record-worker.mjs --replay-failed",
    "commits:worker": "node scripts/commit-record-worker.mjs",
    "commits:status": "node scripts/commit-record-worker.mjs --status",
    "commits:dry-run": "node scripts/commit-record-worker.mjs --once --dry-run",
    "commits:replay": "node scripts/commit-record-worker.mjs --replay-failed",
    "notify:ask": "node scripts/notify-ask.mjs",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -StartNow",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -Uninstall",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -Status",
    "autostart:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-watch-background.ps1",
    "autostart:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-watch-background.ps1",
    "dashboard": "node scripts/dashboard-server.mjs",
    "mcp:stdio": "node scripts/mcp-stdio-server.mjs",
    "build": "node scripts/build-team-package.mjs",
    "team:install": "node scripts/team-setup.mjs install",
    "team:doctor": "node scripts/team-setup.mjs doctor",
    "team:uninstall": "node scripts/team-setup.mjs uninstall",
    "test": "node --test"
  }
}
